<div class="container-fluid py-4">
  <div class="row mb-4">
    <div class="col-12">

      <div class="d-flex justify-content-between align-items-center mb-4">

        <h1 class="display-5 fw-bold neon-text mb-0">
          Мои Вишлисты
        </h1>

        <%= link_to new_wishlist_path, class: 'btn btn-primary btn-lg shadow-sm' do %>
          Создать вишлист
        <% end %>

      </div>

    </div>
  </div>

  <% if @wishlists.any? %>
    <div class="row g-4">

      <% @wishlists.each do |wishlist| %>
        <div class="col-lg-4 col-md-6">

          <div class="card h-100 shadow-sm border-0 hover-card neon-glow">
            <div class="card-body d-flex flex-column">

              <div class="d-flex justify-content-between align-items-start mb-3">
                <h5 class="card-title fw-bold mb-0 text-white">
                  <%= wishlist.name %>
                </h5>

                <span class="badge bg-primary rounded-pill">
                  <%= wishlist.gifts.count %> 🎁
                </span>
              </div>

              <div class="mb-3 text-white">
                <div class="d-flex align-items-center">
                  📅 <span class="ms-2">
                    <%= wishlist.event_date&.strftime('%d.%m.%Y') %>
                  </span>
                </div>

                <% if wishlist.event_date %>
                  <% days_left = (wishlist.event_date - Date.today).to_i %>

                  <% if days_left > 0 %>
                    <small class="text-success">
                      Осталось <%= days_left %> дней
                    </small>
                  <% elsif days_left == 0 %>
                    <small class="text-danger fw-bold">
                      Сегодня!
                    </small>
                  <% end %>
                <% end %>

              </div>

              <div class="mt-auto">

                <div class="btn-group w-100">
                  <%= link_to wishlist, class: 'btn btn-outline-primary' do %>
                    Открыть
                  <% end %>

                  <% if wishlist_owner?(wishlist) %>
                    <%= link_to edit_wishlist_path(wishlist), class: 'btn btn-outline-secondary' do %>
                      Редактировать
                    <% end %>

                    <%= button_to wishlist, method: :delete,
                        data: { turbo_confirm: 'Удалить вишлист?' },
                        class: 'btn btn-outline-danger' do %>
                      Удалить
                    <% end %>
                  <% end %>
                </div>

              </div>

            </div>
          </div>

        </div>
      <% end %>

    </div>
  <% else %>

    <div class="text-center py-5">
      <h3 class="text-white">Вишлистов пока нет</h3>
      <p class="text-white">Создайте первый вишлист</p>
    </div>

  <% end %>

</div>